{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "example-echo events",
  "description": "Validated against the complete event object (envelope included).",
  "oneOf": [
    {
      "properties": {
        "type": { "const": "echo.block" },
        "data": {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0 },
            "bytes": { "type": "integer", "minimum": 1 }
          },
          "required": ["seq", "bytes"],
          "additionalProperties": false
        }
      },
      "required": ["type", "data"]
    },
    {
      "properties": {
        "type": { "const": "echo.summary" },
        "data": {
          "type": "object",
          "properties": {
            "blocks": { "type": "integer", "minimum": 0 },
            "bytes": { "type": "integer", "minimum": 0 }
          },
          "required": ["blocks", "bytes"],
          "additionalProperties": false
        }
      },
      "required": ["type", "data"]
    }
  ]
}
