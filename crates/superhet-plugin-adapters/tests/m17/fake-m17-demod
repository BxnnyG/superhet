#!/usr/bin/env python3
"""Stand-in for m17-demod in the M17 adapter's integration test (tests/m17_plugin.rs).

Reads 48 kHz s16le baseband on stdin like the real tool; for every 40 ms of input (one M17
frame) it writes 40 ms of decoded voice (8 kHz s16le, a sine) to stdout and, like `m17-demod -l`,
prints the link setup frame once at the start of the call and `EOS` after the last frame.

Environment: FAKE_M17_LSF the LSF line to print (required), FAKE_M17_FRAMES frames per call
(default 10), FAKE_M17_EOS=0 to leave out the end marker, FAKE_M17_DIE=1 to exit with status 3
after the call, FAKE_M17_ARGS=<file> to record the command line.
"""

import math
import os
import struct
import sys
import time

if os.environ.get("FAKE_M17_ARGS"):
    with open(os.environ["FAKE_M17_ARGS"], "w") as f:
        f.write(" ".join(sys.argv[1:]))

lsf = os.environ["FAKE_M17_LSF"]
frames = int(os.environ.get("FAKE_M17_FRAMES", "10"))
with_eos = os.environ.get("FAKE_M17_EOS", "1") == "1"
die = os.environ.get("FAKE_M17_DIE") == "1"

FRAME_BYTES = 48000 * 2 * 40 // 1000  # 40 ms of input

pending = b""
done = 0
phase = 0
while True:
    data = os.read(0, 65536)
    if not data:
        sys.exit(0)
    pending += data
    while len(pending) >= FRAME_BYTES:
        pending = pending[FRAME_BYTES:]
        if done >= frames:
            continue
        if done == 0:
            sys.stderr.write(f"\n{lsf}\n")
            sys.stderr.flush()
        samples = []
        for _ in range(320):
            samples.append(int(8000 * math.sin(phase)))
            phase += 2 * math.pi * 440 / 8000
        sys.stdout.buffer.write(struct.pack("<320h", *samples))
        sys.stdout.buffer.flush()
        done += 1
        if done == frames:
            if with_eos:
                sys.stderr.write("\nEOS\n")
                sys.stderr.flush()
            if die:
                time.sleep(0.2)
                sys.exit(3)
