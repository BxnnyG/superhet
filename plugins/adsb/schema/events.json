{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADS-B plugin events",
  "description": "Validated against the complete event object (envelope included). Every event carries a human readable summary (the decoder history shows it). Fields of an aircraft that were not received are absent.",
  "oneOf": [
    {
      "properties": {
        "type": { "const": "adsb.aircraft" },
        "data": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "icao": { "type": "string", "pattern": "^~?[0-9a-f]{6}$" },
            "callsign": { "type": "string", "minLength": 1, "maxLength": 8 },
            "alt_ft": { "type": "integer" },
            "on_ground": { "const": true },
            "speed_kt": { "type": "number", "minimum": 0 },
            "track_deg": { "type": "number", "minimum": 0, "maximum": 360 },
            "vrate_fpm": { "type": "integer" },
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "rssi": { "type": "number" },
            "squawk": { "type": "string" },
            "category": { "type": "string" }
          },
          "required": ["summary", "icao"],
          "dependentRequired": { "lat": ["lon"], "lon": ["lat"] }
        }
      },
      "required": ["type", "data"]
    },
    {
      "properties": {
        "type": { "const": "adsb.range" },
        "data": {
          "type": "object",
          "description": "Once a minute: the farthest positions heard in that minute per bearing sector and altitude band, and the activity of the minute. Not a history event: the worker stores it in the range statistics.",
          "properties": {
            "summary": { "type": "string" },
            "minute_ms": { "type": "integer", "minimum": 0 },
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "msgs_per_s": { "type": "number", "minimum": 0 },
            "aircraft": { "type": "integer", "minimum": 0 },
            "with_position": { "type": "integer", "minimum": 0 },
            "sectors": {
              "type": "array",
              "maxItems": 432,
              "items": {
                "type": "array",
                "prefixItems": [
                  { "type": "integer", "minimum": 0, "maximum": 71 },
                  { "type": "integer", "minimum": 0, "maximum": 5 },
                  { "type": "number", "minimum": 0 },
                  { "type": "string" }
                ],
                "minItems": 4,
                "maxItems": 4
              }
            }
          },
          "required": ["summary", "minute_ms", "msgs_per_s", "aircraft", "with_position", "sectors"],
          "dependentRequired": { "lat": ["lon"], "lon": ["lat"] }
        }
      },
      "required": ["type", "data"]
    },
    {
      "properties": {
        "type": { "const": "adsb.error" },
        "data": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "message": { "type": "string" }
          },
          "required": ["summary", "message"]
        }
      },
      "required": ["type", "data"]
    }
  ]
}
