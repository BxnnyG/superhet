{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`reconfigure`: new configuration for an instance.",
  "properties": {
    "config": {
      "default": null,
      "description": "The complete new configuration (object or `null` for the plugin's defaults)."
    },
    "id": {
      "description": "Instance id.",
      "type": "string"
    },
    "v": {
      "description": "Contract version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "v",
    "id"
  ],
  "title": "ReconfigureRequest",
  "type": "object"
}
