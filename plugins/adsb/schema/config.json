{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADS-B instance configuration",
  "type": "object",
  "properties": {
    "lat": { "description": "Receiver latitude (with lon).", "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "description": "Receiver longitude (with lat).", "type": "number", "minimum": -180, "maximum": 180 },
    "event_interval_s": {
      "description": "Shortest time between two history events of one aircraft (seconds).",
      "type": "number",
      "minimum": 5,
      "maximum": 86400
    },
    "poll_ms": { "description": "How often aircraft.json is read (ms).", "type": "number", "minimum": 50, "maximum": 10000 }
  },
  "dependentRequired": { "lat": ["lon"], "lon": ["lat"] },
  "additionalProperties": false
}
