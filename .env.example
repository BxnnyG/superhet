# Copy to .env (or run scripts/gen-secrets.sh to generate one with random passwords).
# .env is gitignored; never commit real secrets.

# PostgreSQL (user and database are both "superhet")
POSTGRES_PASSWORD=change-me

# NATS: one user per service, see deploy/nats/nats.conf
NATS_API_PASSWORD=change-me
NATS_SDRD_PASSWORD=change-me
NATS_PLUGINHOST_PASSWORD=change-me
NATS_WORKER_PASSWORD=change-me

# Extra browser origins allowed to open the api WebSocket (comma separated,
# e.g. https://sdr.example.org). Empty = same origin as the Host header only.
SUPERHET_ALLOWED_ORIGINS=

# Auth (superhet-api). On first run api logs a one-time setup token (WARN level, read it with
# `docker compose logs superhet-api`); the web UI asks for it when creating the admin account.
# Pin it instead (at least 16 characters) if you prefer; it stops mattering once the account exists.
SUPERHET_SETUP_TOKEN=
# Session cookie "Secure" attribute: auto (only when the request arrived over https),
# true (always; use behind a TLS reverse proxy), false (never; plain-http LAN).
SUPERHET_COOKIE_SECURE=auto
# Set to true only when api runs behind a reverse proxy that sets X-Forwarded-For and
# X-Forwarded-Proto (needed for per-client rate limiting and "auto" cookies behind TLS).
SUPERHET_TRUST_PROXY=false
# Safer: only believe forwarding headers from these proxies (comma separated addresses/networks,
# e.g. 172.16.0.0/12 or the address of your Caddy/nginx/Traefik). Every other peer's headers are
# ignored. See docs/client-addresses.md (also: why the admin console may show 172.x.0.1 for
# everybody, and the host-network override deploy/compose.hostnet.yaml).
SUPERHET_TRUSTED_PROXIES=
# Reverse DNS names in the admin console (sends client addresses to your resolver): true|false.
SUPERHET_REVERSE_DNS=true
# Optional offline GeoIP: comma separated .mmdb paths inside the api container (DB-IP Lite or
# MaxMind GeoLite2 that you download yourself; nothing is bundled). Mount them read-only.
SUPERHET_GEOIP_DB=
# Prometheus /metrics of the api on a separate, unauthenticated listener (off when empty), e.g.
# 0.0.0.0:8077. Never publish that port; reach it from the compose network only (docs/perf.md).
# sdrd (:8074) and worker (:8076) always serve /metrics on their unpublished ports.
SUPERHET_METRICS_LISTEN=

# RTL-SDR (superhet-sdrd). Device spec: rtlsdr:<index|serial>[?rate=<Hz>&freq=<Hz>&gain=auto|<dB>&ppm=<n>].
# Leave SUPERHET_DEVICE unset for rtlsdr:0, or set it empty to run without a dongle.
# SUPERHET_DEVICE=rtlsdr:0
# SUPERHET_DEVICE_ID=dev0
# Most VFOs (demodulated channels) the daemon runs at once, 1-64 (default 8). Every NFM/AM VFO
# costs about 2-3 % of one core, WFM stereo more (docs/perf.md). Per-user limits (listeners,
# operators, guests) are set on the admin page and stay below this cap.
# SUPERHET_MAX_VFOS=8
# ADS-B map tiles (default OpenStreetMap): template with {z}/{x}/{y}, plain-text attribution.
# SUPERHET_MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
# SUPERHET_MAP_ATTRIBUTION=Example tiles
# SUPERHET_MAP_ATTRIBUTION_URL=https://tiles.example.org/copyright
# Tiles are fetched and cached by superhet-api (proxy, default); "direct" makes every browser
# contact the tile server itself (OSM rejects that on self-hosted/LAN origins).
# SUPERHET_MAP_TILE_MODE=proxy
# SUPERHET_MAP_TILE_CACHE_MAX_MB=512
# Numeric group id that owns the dongle's /dev/bus/usb node (default 46 = plugdev on Debian/Ubuntu).
# Find it with `lsusb -d 0bda:` (Bus BBB Device DDD), then `stat -c %g /dev/bus/usb/BBB/DDD`.
# SUPERHET_USB_GID=46

# Published-image installs (release compose.yaml): moving channel or fixed version of
# ghcr.io/bxnnyg/superhet, used by `docker compose pull && docker compose up -d`.
#   next = newest release incl. pre-releases, latest = newest stable, edge = main,
#   or pin a version such as 0.1.0-alpha.3. install.sh writes this for you.
# SUPERHET_TAG=next
# From a source checkout: run a published image instead of building locally (full image reference).
# SUPERHET_IMAGE=ghcr.io/bxnnyg/superhet:next
# SUPERHET_IMAGE=

# Host port of the web UI / api (the only published port).
# SUPERHET_PORT=8073
