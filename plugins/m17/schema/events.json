{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M17 events",
  "description": "Validated against the complete event object (envelope included). A call produces one m17.call.start when its link setup frame is decoded and one m17.call.end (same call id and fields, plus the outcome) when it is over.",
  "$defs": {
    "call": {
      "type": "object",
      "properties": {
        "call": { "description": "Id of the call (its start time, Unix ms).", "type": "string" },
        "src": { "description": "Callsign of the transmitting station.", "type": "string", "minLength": 1, "maxLength": 12 },
        "dst": { "description": "Destination callsign (BROADCAST, ALL, a station or a group).", "type": "string", "minLength": 1, "maxLength": 12 },
        "can": { "description": "Channel access number.", "type": "integer", "minimum": 0, "maximum": 15 },
        "mode": { "enum": ["voice", "voice+data", "data", "unknown"] },
        "encrypted": { "type": "boolean" },
        "encryption": { "enum": ["none", "scrambler", "aes", "reserved"] },
        "text": { "description": "Text message from the LSF META field.", "type": "string" },
        "position": {
          "type": "object",
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "altitude_m": { "type": "number" },
            "speed_kmh": { "type": "number", "minimum": 0 },
            "bearing_deg": { "type": "integer", "minimum": 0, "maximum": 359 },
            "radius_m": { "description": "Position uncertainty, 1..128 m.", "type": "integer", "minimum": 1, "maximum": 128 },
            "source": { "enum": ["m17-client", "openrtx", "other"] },
            "station": { "enum": ["fixed", "mobile", "handheld", "other"] }
          },
          "required": ["lat", "lon"],
          "additionalProperties": false
        }
      },
      "required": ["call", "src", "dst", "can", "mode"]
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "m17.call.start" },
        "data": { "$ref": "#/$defs/call" }
      },
      "required": ["type", "data"]
    },
    {
      "properties": {
        "type": { "const": "m17.call.end" },
        "data": {
          "allOf": [{ "$ref": "#/$defs/call" }],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 0 },
            "audio_ms": { "description": "Length of the decoded voice.", "type": "integer", "minimum": 0 },
            "muted": { "description": "True when the audio was withheld (encrypted call).", "type": "boolean" },
            "reason": { "enum": ["eos", "lost", "new-call", "stop"] }
          },
          "required": ["duration_ms", "audio_ms", "reason"]
        }
      },
      "required": ["type", "data"]
    }
  ]
}
