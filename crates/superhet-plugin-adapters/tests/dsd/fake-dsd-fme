#!/usr/bin/env python3
"""Stand-in for dsd-fme in the DSD adapter's integration test (tests/dsd_plugin.rs).

dsd-fme itself must never be part of this repository (it carries the AMBE vocoder), so the test
replays a recorded log instead. Reads 48 kHz s16le baseband on stdin like the real tool; for every
40 ms of input it plays back one step of the transcript: the lines up to the next `---` go to
stderr (the tool's log) and, when a line mentions voice, 40 ms of decoded voice (8 kHz s16le, a
sine, like `-o -`) go to stdout. Comment lines (#) are skipped. When the transcript is used up the
tool stays silent.

Environment: FAKE_DSD_TRANSCRIPT the transcript file (required), FAKE_DSD_DIE=1 to exit with status
3 after the last step, FAKE_DSD_ARGS=<file> to record the command line.
"""

import math
import os
import struct
import sys
import time

if os.environ.get("FAKE_DSD_ARGS"):
    with open(os.environ["FAKE_DSD_ARGS"], "w") as f:
        f.write(" ".join(sys.argv[1:]))

steps = [[]]
with open(os.environ["FAKE_DSD_TRANSCRIPT"], encoding="utf-8") as f:
    for line in f.read().splitlines():
        if line.startswith("#") or not line.strip():
            continue
        if line.strip() == "---":
            steps.append([])
        else:
            steps[-1].append(line)
die = os.environ.get("FAKE_DSD_DIE") == "1"
no_audio = "null" in sys.argv

FRAME_BYTES = 48000 * 2 * 40 // 1000  # 40 ms of input

pending = b""
done = 0
phase = 0.0
while True:
    data = os.read(0, 65536)
    if not data:
        sys.exit(0)
    pending += data
    while len(pending) >= FRAME_BYTES:
        pending = pending[FRAME_BYTES:]
        if done >= len(steps):
            continue
        step = steps[done]
        done += 1
        for line in step:
            sys.stderr.write(line + "\n")
        sys.stderr.flush()
        if not no_audio and any("voice" in line.lower() for line in step):
            # The real tool prints a burst's log before its audio; give the adapter's two reader
            # threads time to see the lines first, also on a loaded machine.
            time.sleep(0.03)
            samples = []
            for _ in range(320):
                samples.append(int(8000 * math.sin(phase)))
                phase += 2 * math.pi * 440 / 8000
            sys.stdout.buffer.write(struct.pack("<320h", *samples))
            sys.stdout.buffer.flush()
        if done == len(steps) and die:
            time.sleep(0.2)
            sys.exit(3)
