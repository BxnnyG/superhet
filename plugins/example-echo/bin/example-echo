#!/usr/bin/env python3
"""Reference plugin for the Superhet plugin contract v1 (simple transport).

stdin  = raw samples; stdout = JSON Lines events; stderr = log lines.
Configuration arrives as JSON in SUPERHET_CONFIG; `mode` selects the behaviour:

  normal   (default) one echo.block per read, heartbeat while idle, echo.summary and exit 0 at EOF
  invalid  like normal, but also writes lines the host must reject
  crash    exits with status 3 right after start
  hang     never reads, never writes (exercises the heartbeat watchdog)
"""
import datetime
import json
import os
import select
import sys
import time


def emit(event_type, data=None):
    now = datetime.datetime.now(datetime.timezone.utc)
    event = {
        "v": 1,
        "type": event_type,
        "ts": now.strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z",
        "data": data or {},
    }
    sys.stdout.write(json.dumps(event, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def raw(line):
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def main():
    config = json.loads(os.environ.get("SUPERHET_CONFIG") or "null") or {}
    mode = config.get("mode", "normal")
    print(f"example-echo starting, mode={mode}", file=sys.stderr, flush=True)
    if mode == "crash":
        sys.exit(3)
    if mode == "hang":
        while True:
            time.sleep(3600)

    blocks = 0
    total = 0
    while True:
        ready, _, _ = select.select([0], [], [], 1.0)
        if not ready:
            emit("heartbeat")
            continue
        chunk = os.read(0, 4096)
        if not chunk:
            break
        emit("echo.block", {"seq": blocks, "bytes": len(chunk)})
        blocks += 1
        total += len(chunk)
        if mode == "invalid":
            raw("this is not json")
            raw('{"v":2,"type":"echo.block","data":{"seq":0,"bytes":1}}')
            raw('{"v":1,"type":"echo.block","data":{"seq":"x","bytes":1}}')
    emit("echo.summary", {"blocks": blocks, "bytes": total})


if __name__ == "__main__":
    main()
