#!/usr/bin/env python3
"""Stand-in for the ETSI speech decoder (sdecoder) in tests/tetra_plugin.rs: one 276-byte parameter
frame in, 60 ms of 8 kHz s16le speech (a 440 Hz sine) out. The real one is the user's."""

import math
import os
import struct
import sys

source = os.open(sys.argv[1], os.O_RDONLY)
sink = os.open(sys.argv[2], os.O_WRONLY)
pending = b""
phase = 0.0
while True:
    data = os.read(source, 65536)
    if not data:
        sys.exit(0)
    pending += data
    while len(pending) >= 276:
        pending = pending[276:]
        samples = []
        for _ in range(480):
            samples.append(int(8000 * math.sin(phase)))
            phase += 2 * math.pi * 440 / 8000
        os.write(sink, struct.pack("<480h", *samples))
